{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Doom 3 BFG x64 Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "x64-Debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build Doom 3 BFG x64 Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "x64-Debug"
      ],
      "dependsOn": "Configure Doom 3 BFG x64 Debug",
      "dependsOrder": "sequence",
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Configure Doom 3 BFG x64 Release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "x64-Release"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build Doom 3 BFG x64 Release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "x64-Release"
      ],
      "dependsOn": "Configure Doom 3 BFG x64 Release",
      "dependsOrder": "sequence",
      "problemMatcher": [
        "$gcc",
        "$msCompile"
      ]
    },
    {
      "label": "Test Doom 3 BFG x64 Debug",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "${workspaceFolder}/out/build/x64-Debug",
        "--output-on-failure"
      ],
      "dependsOn": "Build Doom 3 BFG x64 Debug",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Test Doom 3 BFG x64 Release",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "${workspaceFolder}/out/build/x64-Release",
        "--output-on-failure"
      ],
      "dependsOn": "Build Doom 3 BFG x64 Release",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
