{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Doom 3 BFG x64 Debug (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/x64-Debug/Doom3BFG.exe",
      "args": [
        "+set",
        "fs_basepath",
        "${workspaceFolder}"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Doom 3 BFG x64 Debug",
      "externalConsole": false,
      "stopAtEntry": false
    },
    {
      "name": "Doom 3 BFG x64 Debug (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/x64-Debug/Doom3BFG.exe",
      "args": [
        "+set",
        "fs_basepath",
        "${workspaceFolder}"
      ],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${workspaceFolder}/out/build/x64-Debug;${env:PATH}"
        }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "preLaunchTask": "Build Doom 3 BFG x64 Debug",
      "externalConsole": false,
      "stopAtEntry": false
    },
    {
      "name": "Doom 3 BFG x64 Release (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/x64-Release/Doom3BFG.exe",
      "args": [
        "+set",
        "fs_basepath",
        "${workspaceFolder}"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Doom 3 BFG x64 Release",
      "externalConsole": false,
      "stopAtEntry": false
    }
  ]
}
